{
	"compilerOptions": {
		"target": "es2023",
		"module": "commonjs",
		"noImplicitAny": true,
		"noEmitHelpers": false,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"removeComments": true,
		"sourceMap": false,
		"isolatedModules": false,
		"strictNullChecks": false,
        "strictPropertyInitialization": false,
		"paths": {
		  // See https://stackoverflow.com/questions/79923194/option-baseurl-is-deprecated-and-will-stop-functioning-in-typescript-7
			"*": ["./*"]
		},
		"typeRoots": ["./system", "./node_modules"],
        "types": ["PIXI.d.ts"],
        "ignoreDeprecations": "6.0"
	},
	"compileOnSave": true
}
