{
	"compilerOptions": {
		"target": "es2023",
		"module": "commonjs",
		"noImplicitAny": true,
		"noEmitHelpers": false,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"removeComments": true,
		"sourceMap": false,
		"isolatedModules": false,
		"strictNullChecks": false,
        "strictPropertyInitialization": false,
		"rootDir":".",
		"typeRoots": ["./system", "./node_modules"],
        "types": ["PIXI.d.ts"],
        "ignoreDeprecations": "6.0"
	},
	"compileOnSave": true
}
